{
  "id": 4,
  "theme_name": "Theme 4 — ShopUS",
  "version": "1.0.0",
  "groups": [
    {
      "id": "layout",
      "label": "Homepage",
      "fields": [
        {
          "key": "layout.home_layout",
          "type": "select",
          "label": "Active homepage",
          "default": "1",
          "maps_to": "home_layout",
          "options": {
            "1": "Home 1 — Classic slider",
            "2": "Home 2 — Split hero",
            "3": "Home 3 — Full-width slider"
          }
        },
        {"key": "hero.enabled", "type": "boolean", "label": "Show hero", "default": true},
        {"key": "hero.show_button", "type": "boolean", "label": "Show hero button", "default": true},
        {"key": "categories.enabled", "type": "boolean", "label": "Show category strip", "default": true},
        {"key": "homepage.show_featured", "type": "boolean", "label": "Show featured products", "default": true},
        {"key": "homepage.show_sale", "type": "boolean", "label": "Show on-sale products", "default": true}
      ]
    },
    {
      "id": "header",
      "label": "Header & menu",
      "fields": [
        {"key": "header.announcement_bar", "type": "boolean", "label": "Show top bar", "default": true},
        {"key": "header.show_logo", "type": "boolean", "label": "Show logo", "default": true},
        {"key": "header.show_search", "type": "boolean", "label": "Show search", "default": true},
        {"key": "header.show_cart", "type": "boolean", "label": "Show cart", "default": true},
        {"key": "header.show_category_menu", "type": "boolean", "label": "Show All Categories dropdown", "default": true},
        {"key": "header.show_menu", "type": "boolean", "label": "Show header pages menu", "default": true}
      ]
    },
    {
      "id": "colors",
      "label": "Color scheme",
      "fields": [
        {"key": "colors.primary", "type": "color", "label": "Primary / accent", "default": "#AE1C9A", "maps_to": "primary_color"},
        {"key": "colors.navigation", "type": "color", "label": "Header / nav", "default": "rgba(174, 28, 154, 0.08)", "maps_to": "navigation_color"},
        {"key": "colors.button", "type": "color", "label": "Buttons", "default": "#AE1C9A", "maps_to": "button_color"}
      ]
    },
    {
      "id": "products",
      "label": "Product cards",
      "fields": [
        {"key": "products.show_price", "type": "boolean", "label": "Show price", "default": true},
        {"key": "products.show_compare_price", "type": "boolean", "label": "Show compare-at price", "default": true},
        {"key": "products.show_add_to_cart", "type": "boolean", "label": "Show add to cart", "default": true}
      ]
    },
    {
      "id": "product_detail",
      "label": "Product detail page",
      "fields": [
        {"key": "products.show_tags", "type": "boolean", "label": "Show product tags", "default": true}
      ]
    },
    {
      "id": "footer",
      "label": "Footer",
      "fields": [
        {"key": "footer.enabled", "type": "boolean", "label": "Show footer", "default": true},
        {"key": "footer.social_links", "type": "boolean", "label": "Show social links", "default": true}
      ]
    }
  ]
}
