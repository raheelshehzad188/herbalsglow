<IfModule mod_rewrite.c>
    RewriteEngine On

    # Existing files/folders
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Subdirectory install: http://localhost/herbalsglow/...
    RewriteCond %{REQUEST_URI} ^/herbalsglow/
    RewriteCond %{DOCUMENT_ROOT}/herbalsglow/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteCond %{REQUEST_URI} ^/herbalsglow/
    RewriteRule ^(.*)$ /herbalsglow/index.php/$1 [L,QSA]

    # Virtual host install: DocumentRoot is this project
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.*)$ public/$1 [L]

    RewriteRule ^(.*)$ index.php/$1 [L,QSA]
</IfModule>
